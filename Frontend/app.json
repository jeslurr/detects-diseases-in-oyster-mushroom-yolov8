{
  "expo": {
    "name": "Oyster Disease Detection",
    "slug": "oyster-disease-detection",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "oysterdetect",
    "newArchEnabled": true,
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#F7F8F5"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "This app uses the camera to photograph mushroom bags for disease detection.",
        "NSPhotoLibraryUsageDescription": "This app accesses your photos to analyze mushroom bag images."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#3E5D46"
      },
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-camera",
      "expo-image-picker",
      [
        "expo-font",
        {
          "fonts": []
        }
      ],
      "expo-asset"
    ],
    "extra": {
      "apiUrl": "http://localhost:8000"
    }
  }
}
